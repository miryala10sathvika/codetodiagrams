@startuml
!define DEVICON https://raw.githubusercontent.com/tupadr3g/plantuml-icon-font-sprites/v2.2.0
!define Component(element, alias, sprite, description) component element as alias sprite description
!define Storage(element, alias, sprite, description) node element as alias sprite description

' Components
Component(MatryxSystem, system, <$DEVICON/server>, "Registry and Upgrade Manager")
Component(MatryxPlatform, platform, <$DEVICON/server>, "Core Platform Logic and Data Storage")
Component(MatryxCommit, commit, <$DEVICON/server>, "Commit System Management")
Component(MatryxForwarder, forwarder, <$DEVICON/server>, "Delegate Call Enforcer")
Component(MatryxToken, token, <$DEVICON/server>, "ERC20 Token")

' Libraries
Component(LibCommit, libCommit, <$DEVICON/database>, "Commit Logic Library")
Component(LibTournament, libTournament, <$DEVICON/database>, "Tournament Logic Library")
Component(LibPlatform, libPlatform, <$DEVICON/database>, "Platform Operations Library")
Component(LibGlobals, libGlobals, <$DEVICON/database>, "Global Variables Library")

' Testing
Component(TestContracts, testContracts, <$DEVICON/laptop>, "Mock Contracts for Testing")

' Relationships
platform -- LibPlatform : Uses
platform -- LibTournament : Uses
commit -- LibCommit : Uses

system -- platform : Manages
system -- libPlatform : Manages
system -- libTournament : Manages
system -- libCommit : Manages
system -- commit : Manages
system -- forwarder : Manages

forwarder -- platform : Forwards Calls
forwarder -- libPlatform : Forwards Calls
forwarder -- libTournament : Forwards Calls
forwarder -- libCommit : Forwards Calls

platform -- token : Uses
commit -- token : Uses

TestContracts ..> platform : Tests
TestContracts ..> commit : Tests
TestContracts ..> token : Tests

platform -- LibGlobals : Uses
@enduml
