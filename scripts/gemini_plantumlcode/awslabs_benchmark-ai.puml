@startuml
!define AWSPuml https://raw.githubusercontent.com/awslabs/aws-icons-for-plantuml/v16.0/dist
!include AWSPuml/AWSCommon.puml
!include AWSPuml/Storage/S3.puml
!include AWSPuml/Database/Elasticache.puml
!include AWSPuml/ApplicationIntegration/Kafka.puml
!include AWSPuml/Compute/EKS.puml
!include AWSPuml/ManagementGovernance/Cloudwatch.puml

node "Anubis Platform" {

    [User] -right-> [BAI BFF] : API Requests
    component "BAI BFF" {
      [BAI BFF]
    }
    
    [BAI BFF] -down-> [Kafka Cluster] : Job Submissions & Events
    
    cloud "Kafka Cluster" {
        [Kafka Cluster]
    }

    component "Fetcher" {
        [Fetcher]
    }
    
    component "Executor" {
        [Executor]
        [SM Executor]
    }

    component "Watcher" {
        [Watcher]
    }

    component "Metrics Extractor" {
        [Metrics Extractor]
    }

    component "Metrics Pusher" {
        [Metrics Pusher]
    }

    component "Cloudwatch Exporter" {
        [Cloudwatch Exporter]
    }

    [Kafka Cluster] -down-> [Fetcher] : Job Events
    [Kafka Cluster] -down-> [Executor] : Data Fetching Events

    [Fetcher] --right-> [S3 Bucket] : Dataset Retrieval
    AWS_S3(S3 Bucket, S3, "Bucket")
    
    [Executor] -down-> [EKS Cluster] : Benchmark Execution
    [Executor] -down-> [SM Executor] : Benchmark Execution
    EKS(EKS Cluster, "EKS Cluster")
    
    [Kafka Cluster] -down-> [Watcher] : Job Status Updates
    [Kafka Cluster] -down-> [Metrics Extractor] : Logs

    [Metrics Extractor] -down-> [Kafka Cluster] : Metrics
    [Metrics Extractor] -- [Metrics Pusher]
    [Metrics Pusher] -down-> [Kafka Cluster] : Metrics
    [Kafka Cluster] -down-> [Cloudwatch Exporter] : Metrics

    [Cloudwatch Exporter] -- [Cloudwatch]
    CloudWatch(Cloudwatch, CloudWatch)
    

    component "Anubis Cron Job" {
        [Anubis Cron Job]
    }

    [Anubis Cron Job] -down-> [Kafka Cluster] : Triggered Jobs
    
    component "Job Status Trigger" {
      [Job Status Trigger]
    }
    
    component "Puller" {
      [Puller]
    }
        
    component "Report" {
      [Report]
    }
    
    
}

center footer AWS Services are implicitly used within the components, such as S3 for data storage, EC2 for compute, etc.

@enduml
