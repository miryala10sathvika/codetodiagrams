' Components

package "ZSwag" {

  [README.md] as Readme
  [zswag.sln] as SolutionFile

  package "Projects" {
    component "ZSwag.Core" {
      [SwaggerGenerator.cs] as SwaggerGenerator
      [SwaggerOptions.cs] as SwaggerOptions
      [SchemaGenerator.cs] as SchemaGenerator
      [OperationGenerator.cs] as OperationGenerator
    }

    component "ZSwag.AspNetCore" {
      [ZSwagMiddleware.cs] as Middleware
      [ZSwagExtensions.cs] as Extensions
    }

    component "ZSwag.CommandLine" as CommandLine
    component "Test Projects" as Tests
  }
}

' Connections
Readme -- SolutionFile : Describes
SolutionFile -- SwaggerGenerator : Contains
SolutionFile -- SwaggerOptions : Contains
SolutionFile -- SchemaGenerator : Contains
SolutionFile -- OperationGenerator : Contains
SolutionFile -- Middleware : Contains
SolutionFile -- Extensions : Contains
SolutionFile -- CommandLine : Contains
SolutionFile -- Tests : Contains

Middleware -- SwaggerGenerator : Uses
Extensions -- Middleware : Uses
